# FounderOS API — Production Environment Variables
# Copy to .env and fill in real values:
#   cp .env.production.example .env && nano .env

# ── Database ─────────────────────────────────────────────────────
# Use the PostgreSQL user/password created by setup-droplet.sh
DATABASE_URL=postgresql+asyncpg://founderos:CHANGE_ME@localhost:5432/founder_os

# ── Supabase Auth ────────────────────────────────────────────────
SUPABASE_URL=https://xwqcnmmdodiireigtjkb.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── OpenAI (RAG embeddings + chat) ──────────────────────────────
# Server-default key used when workspaces haven't configured their own
OPENAI_API_KEY=your-openai-api-key

# ── Encryption (AES-256-GCM for API key storage) ────────────────
# Generate with:
#   python -c "from cryptography.hazmat.primitives.ciphers.aead import AESGCM; import base64; print(base64.urlsafe_b64encode(AESGCM.generate_key(bit_length=256)).decode())"
ENCRYPTION_KEY=your-base64-encoded-256-bit-key

# ── CORS ─────────────────────────────────────────────────────────
# Add your mobile app's origin and any web domains
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,https://founderos.app

# ── File Uploads ─────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
